generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   String                @id @default(cuid())
  email                String                @unique
  name                 String?
  passwordHash         String
  theme                String                @default("dark")
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  careerActions        CareerAction[]
  careerRoadmaps       CareerRoadmap[]
  copilotConversations CopilotConversation[]
  githubAccount        GitHubAccount?
  githubOAuthStates    GitHubOAuthState[]
  interviewSessions    InterviewSession[]
  resume               Resume?
  skillGapAnalyses     SkillGapAnalysis[]
  applications         Application[]
  learningProgress     LearningProgress[]
  dsaEntries           DsaEntry[]
  sessions             Session[]

  @@index([createdAt])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model GitHubAccount {
  id          String   @id @default(cuid())
  userId      String   @unique
  githubId    String   @unique
  login       String
  accessToken String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([login])
}

model InterviewSession {
  id        String            @id @default(cuid())
  project   String
  category  String?
  startedAt DateTime          @default(now())
  endedAt   DateTime?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  userId    String
  answers   InterviewAnswer[]
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([project])
  @@index([createdAt])
}

model InterviewAnswer {
  id                   String           @id @default(cuid())
  sessionId            String
  question             String
  answer               String
  category             String
  difficulty           String
  overall              Int
  technicalCorrectness Int
  relevance            Int
  depth                Int
  communication        Int
  projectKnowledge     Int
  verdict              String
  strengths            String[]
  missingConcepts      String[]
  improvements         String[]
  idealAnswer          String
  followUpQuestion     String?
  createdAt            DateTime         @default(now())
  session              InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model CareerRoadmap {
  id        String              @id @default(cuid())
  role      String
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CareerRoadmapItem[]

  @@index([userId])
  @@index([role])
}

model CareerRoadmapItem {
  id        String        @id @default(cuid())
  roadmapId String
  skill     String
  priority  String
  reason    String
  focus     String[]
  completed Boolean       @default(false)
  progress  Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  roadmap   CareerRoadmap @relation(fields: [roadmapId], references: [id], onDelete: Cascade)

  @@index([roadmapId])
}

model CopilotConversation {
  id        String           @id @default(cuid())
  title     String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  CopilotMessage[]

  @@index([userId])
  @@index([createdAt])
  @@index([updatedAt])
}

model CopilotMessage {
  id             String              @id @default(cuid())
  conversationId String
  role           String
  content        String
  createdAt      DateTime            @default(now())
  conversation   CopilotConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([createdAt])
}

model CareerAction {
  id             String    @id @default(cuid())
  actionId       String
  title          String
  priority       String
  category       String
  reason         String
  impact         String
  steps          String[]
  relatedSkill   String?
  relatedProject String?
  status         String    @default("Pending")
  progress       Int       @default(0)
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, actionId])
  @@index([userId])
  @@index([status])
  @@index([priority])
  @@index([createdAt])
}

model GitHubOAuthState {
  id        String   @id @default(cuid())
  userId    String
  stateHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Resume {
  id        String   @id @default(cuid())
  userId    String   @unique
  fileName  String
  mimeType  String   @default("application/pdf")
  sizeBytes Int
  blobUrl   String
  rawText   String   @db.Text
  analysis  Json?
  score     Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([updatedAt])
}

model SkillGapAnalysis {
  id             String   @id @default(cuid())
  userId         String
  targetRole     String
  jobDescription String?  @db.Text
  requiredSkills String[]
  currentSkills  String[]
  results        Json
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Application {
  id          String   @id @default(cuid())
  userId      String
  company     String
  role        String
  jobUrl      String?
  location    String?
  salary      String?
  description String?  @db.Text
  status      String   @default("SAVED")
  appliedAt   DateTime?
  interviewAt DateTime?
  notes       String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, updatedAt])
  @@index([userId, createdAt])
}

model LearningProgress {
  id              String   @id @default(cuid())
  userId          String
  skill           String
  status          String   @default("NOT_STARTED")
  resourceUrls    String[] @default([])
  practiceNotes   String?  @db.Text
  assessmentNotes String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, skill])
  @@index([userId, status, updatedAt])
}

model DsaEntry {
  id         String   @id @default(cuid())
  userId     String
  topic      String
  problem    String
  problemUrl String?
  difficulty String
  isSolved   Boolean  @default(false)
  attempts   Int      @default(0)
  accuracy   Int      @default(0)
  notes      String?  @db.Text
  solvedAt   DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, topic, updatedAt])
  @@index([userId, isSolved, difficulty])
  @@index([userId, solvedAt])
}
